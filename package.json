{
  "name": "matte",
  "productName": "Matte",
  "version": "1.0.0",
  "description": "Matte — a sleek, modern browser with the Silver Gate UI.",
  "main": "main.js",
  "author": "sillyjoshua",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.matte.browser",
    "productName": "Matte",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "ui/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "Matte-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Matte"
    }
  }
}
